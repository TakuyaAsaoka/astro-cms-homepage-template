---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { publishedWorks } from "../lib/works";
import { fetchFeedItems } from "../lib/rss";
import FormattedDate from "../components/FormattedDate.astro";
import { BASE_PATH } from "../consts";
import { getSiteSettings } from "../site-settings";

const site = await getSiteSettings();

// CMS管理のHome文言を取得する。欠落時はビルドを失敗させて設定漏れを早期に検知する
const homeEntry = await getEntry("home", "home");
if (!homeEntry) {
  throw new Error("Home文言（src/content/pages/home.yaml）が見つかりません");
}
const home = homeEntry.data;

// Homeに載せるピックアップ件数。増減はこの数字だけを変える
const pickupWorks = publishedWorks(await getCollection("works")).slice(0, 3);

// Homeに載せるブログ記事件数。RSS未設定・取得失敗時は空配列（= セクション非描画）
const latestPosts = (await fetchFeedItems(site.noteRssUrl)).slice(0, 3);
---

<BaseLayout title="Home" description={site.description}>
  <div class="home-hero" slot="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="hero-role">{home.hero.role}</p>
        <h1 class="hero-name">{site.author}</h1>
        <span class="hero-rule" aria-hidden="true"></span>
        <p class="hero-copy">{home.hero.tagline}</p>
      </div>
    </div>
  </div>

  {
    /* 公開されている制作が0件なら、見出しごと制作セクションを描画しない。
       中身が空なら容器ごと隠す挙動を連絡先セクション・Footer と統一する。
       セクション番号はCSSカウンタで自動採番されるため、ここが消えても欠番は出ない。 */
  }
  {
    pickupWorks.length > 0 && (
      <section class="home-section">
        <h2 class="section-heading" data-reveal>
          <span class="section-num" aria-hidden="true" />
          <span class="section-title">制作</span>
          <span class="section-label" aria-hidden="true">
            WORKS
          </span>
        </h2>
        <div data-reveal="delayed">
          <ul class="pickup-list" role="list">
            {pickupWorks.map((work) => (
              <li>
                <a class="pickup-title" href={`${BASE_PATH}works/${work.id}/`}>
                  {work.data.title}
                </a>
                <p class="pickup-desc">{work.data.description}</p>
              </li>
            ))}
          </ul>
          <p class="section-more">
            <a href={`${BASE_PATH}works/`}>制作一覧へ</a>
          </p>
        </div>
      </section>
    )
  }

  {
    /* 記事が0件（RSS未設定・取得失敗含む）なら、見出しごと Blog セクションを描画しない。
       中身が空なら容器ごと隠す挙動を制作・連絡先セクションと統一する。
       セクション番号はCSSカウンタで自動採番されるため、ここが消えても欠番は出ない。 */
  }
  {
    latestPosts.length > 0 && (
      <section class="home-section">
        <h2 class="section-heading" data-reveal>
          <span class="section-num" aria-hidden="true" />
          <span class="section-title">Blog</span>
          <span class="section-label" aria-hidden="true">
            BLOG
          </span>
        </h2>
        <div data-reveal="delayed">
          <ul class="blog-list" role="list">
            {latestPosts.map((item) => (
              <li>
                <a href={item.link} target="_blank" rel="noopener noreferrer">
                  {item.title}
                </a>
                <FormattedDate date={item.pubDate} />
              </li>
            ))}
          </ul>
          <p class="section-more">
            <a href={`${BASE_PATH}blog/`}>ブログ一覧へ</a>
          </p>
        </div>
      </section>
    )
  }

  {
    /* スキルが0件なら、見出しごと技術セクションを描画しない。
       中身が空なら容器ごと隠す挙動を他セクションと統一する。 */
  }
  {
    home.skills.length > 0 && (
      <section class="home-section">
        <h2 class="section-heading" data-reveal>
          <span class="section-num" aria-hidden="true" />
          <span class="section-title">技術</span>
          <span class="section-label" aria-hidden="true">
            SKILLS
          </span>
        </h2>
        <ul class="skill-list" role="list" data-reveal="delayed">
          {home.skills.map((skill) => (
            <li>{skill}</li>
          ))}
        </ul>
      </section>
    )
  }

  {
    /* GITHUB・EMAIL の両方が空文字なら、見出しごと連絡先セクションを描画しない。
       中身が空なら容器ごと隠す挙動を Footer（activeLinks.length > 0）と統一する。 */
  }
  {
    (site.social.github || site.email) && (
      <section class="home-section">
        <h2 class="section-heading" data-reveal>
          <span class="section-num" aria-hidden="true" />
          <span class="section-title">連絡先</span>
          <span class="section-label" aria-hidden="true">
            CONTACT
          </span>
        </h2>
        <ul class="contact-list" role="list" data-reveal="delayed">
          {site.social.github && (
            <li>
              <span class="contact-label">GITHUB</span>
              <a
                href={site.social.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                {site.social.github.replace(/^https?:\/\//, "")}
              </a>
            </li>
          )}
          {site.email && (
            <li>
              <span class="contact-label">EMAIL</span>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </li>
          )}
        </ul>
      </section>
    )
  }
</BaseLayout>
