---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { publishedProjects } from "../lib/projects";
import {
  BASE_PATH,
  SITE_DESCRIPTION,
  SOCIAL_LINKS,
  EMAIL,
  SITE_AUTHOR,
} from "../consts";

// スキルセクションに表示する技術タグ
const skills = ["Skill 1", "Skill 2", "Skill 3", "Skill 4"];

// Homeに載せるピックアップ件数。増減はこの数字だけを変える
const pickupProjects = publishedProjects(await getCollection("projects")).slice(
  0,
  3,
);
---

<BaseLayout title="Home" description={SITE_DESCRIPTION}>
  <div class="home-hero" slot="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="hero-role">YOUR ROLE</p>
        <h1 class="hero-name">{SITE_AUTHOR}</h1>
        <span class="hero-rule" aria-hidden="true"></span>
        <p class="hero-copy">ここにキャッチコピーを入れます。</p>
      </div>
    </div>
  </div>

  {
    /* 公開プロジェクトが0件なら、見出しごと制作セクションを描画しない。
       中身が空なら容器ごと隠す挙動を連絡先セクション・Footer と統一する。
       セクション番号はCSSカウンタで自動採番されるため、ここが消えても欠番は出ない。 */
  }
  {
    pickupProjects.length > 0 && (
      <section class="home-section">
        <h2 class="section-heading" data-reveal>
          <span class="section-num" aria-hidden="true" />
          <span class="section-title">制作</span>
          <span class="section-label" aria-hidden="true">
            PROJECTS
          </span>
        </h2>
        <div data-reveal="delayed">
          {pickupProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              slug={project.id}
            />
          ))}
          <p class="section-more">
            <a href={`${BASE_PATH}projects/`}>制作一覧へ</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="home-section">
    <h2 class="section-heading" data-reveal>
      <span class="section-num" aria-hidden="true"></span>
      <span class="section-title">技術</span>
      <span class="section-label" aria-hidden="true">SKILLS</span>
    </h2>
    <ul class="skill-list" role="list" data-reveal="delayed">
      {skills.map((skill) => <li>{skill}</li>)}
    </ul>
  </section>

  {
    /* GITHUB・EMAIL の両方が空文字なら、見出しごと連絡先セクションを描画しない。
       中身が空なら容器ごと隠す挙動を Footer（activeLinks.length > 0）と統一する。 */
  }
  {
    (SOCIAL_LINKS.github || EMAIL) && (
      <section class="home-section">
        <h2 class="section-heading" data-reveal>
          <span class="section-num" aria-hidden="true" />
          <span class="section-title">連絡先</span>
          <span class="section-label" aria-hidden="true">
            CONTACT
          </span>
        </h2>
        <ul class="contact-list" role="list" data-reveal="delayed">
          {SOCIAL_LINKS.github && (
            <li>
              <span class="contact-label">GITHUB</span>
              <a
                href={SOCIAL_LINKS.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                {SOCIAL_LINKS.github.replace(/^https?:\/\//, "")}
              </a>
            </li>
          )}
          {EMAIL && (
            <li>
              <span class="contact-label">EMAIL</span>
              <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            </li>
          )}
        </ul>
      </section>
    )
  }
</BaseLayout>
