---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkCard from "../../components/WorkCard.astro";
import { getCollection } from "astro:content";
import { publishedWorks } from "../../lib/works";

const works = publishedWorks(await getCollection("works"));
---

<BaseLayout
  title="Works"
  description="My works"
  breadcrumb={[{ label: "Works" }]}
>
  <section>
    {
      /* Homeのセクション見出しと同じ語彙を使う（和数字は Home の連番のためのものなので付けない）。
         用語も Home の「制作」に揃え、ページ間で呼び方が変わらないようにする。 */
    }
    <h1 class="section-heading page-heading">
      <span class="section-title">制作</span>
      <span class="section-label" aria-hidden="true">WORKS</span>
    </h1>
    {
      works.length > 0 ? (
        <ul class="work-grid" role="list">
          {works.map((work) => (
            <li>
              <WorkCard
                title={work.data.title}
                description={work.data.description}
                tags={work.data.tags}
                slug={work.id}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p>制作はまだありません。</p>
      )
    }
  </section>
</BaseLayout>

<style>
  /* デスクトップは2カラム、モバイルは1カラム。実効コンテンツ幅（約736px）では
     3カラム以上が成立しないため、auto-fit ではなく固定2カラム＋メディアクエリで
     折返し点を明示する。 */
  /* minmax(0, 1fr): 素の 1fr はカラム幅の下限がコンテンツの min-content になるため、
     折返し不能な要素が1つ入るだけでカラム比が崩れる。下限を0にして構造的に防ぐ。 */
  .work-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  /* li を grid にして内側の article を行の高さまで stretch させ、カード高さを揃える */
  .work-grid li {
    display: grid;
  }
  @media (max-width: 767px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
