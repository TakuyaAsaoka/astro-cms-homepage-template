---
import BaseLayout from "../layouts/BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { fetchFeedItems } from "../lib/rss";
import { getSiteSettings } from "../site-settings";

const site = await getSiteSettings();
const feedItems = await fetchFeedItems(site.noteRssUrl);
---

<BaseLayout title="Blog" description="Blog posts from note">
  <section>
    <h1>Blog</h1>
    {
      site.noteRssUrl === "" && (
        <p>
          Set <code>noteRssUrl</code> in the CMS Site Settings (or{" "}
          <code>src/content/settings/site.yaml</code>) to display blog posts.
        </p>
      )
    }
    {
      feedItems.length > 0 ? (
        <ul class="blog-list" role="list">
          {feedItems.map((item) => (
            <li>
              <a href={item.link} target="_blank" rel="noopener noreferrer">
                {item.title}
              </a>
              <FormattedDate date={item.pubDate} />
            </li>
          ))}
        </ul>
      ) : (
        site.noteRssUrl !== "" && <p>No posts found.</p>
      )
    }
  </section>
</BaseLayout>
