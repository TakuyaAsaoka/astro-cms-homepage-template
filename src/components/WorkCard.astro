---
import { BASE_PATH } from "../consts";
import TagList from "./TagList.astro";

interface Props {
  title: string;
  description: string;
  tags: string[];
  slug: string;
}

const { title, description, tags, slug } = Astro.props;
---

<article class="work-card">
  <h2>
    <a href={`${BASE_PATH}works/${slug}/`}>{title}</a>
  </h2>
  <p class="work-description">{description}</p>
  <TagList tags={tags} />
</article>

<style>
  /* 一覧ページ専用のカード。グリッドに並べるためセル境界を示す囲み枠を持つ
     （Homeの抜粋は通読させる軸なので、罫線区切りの別意匠にしてある）。
     行内でカード高さが揃うよう縦フレックスにする。 */
  .work-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    /* 説明文に折返し不能な文字列（URL等）が入ってもカード内で折り返す。
       これが無いとカードの min-content 幅が広がり、グリッドのカラム比が崩れる */
    overflow-wrap: anywhere;
  }
  /* h2 の既定サイズはカード内では大きすぎるため、カード見出しとして詰める */
  .work-card h2 {
    font-size: 1.15rem;
  }
  /* 文字色は見出しに揃える（リンク色が将来変わってもカード見出しの階調を保つ）。
     下線は打ち消さない: カード全体はリンクではないため、.main-inner a のアクセント
     下線がクリック先を特定する唯一の手がかりになる */
  .work-card h2 a {
    color: inherit;
  }
  .work-description {
    margin-top: 0.5rem;
    color: var(--color-ink-soft);
  }
  /* TagList は余白を持たないため、カード内の余白は消費側で与える。
     高さが揃った行でタグだけ宙に浮かないよう、下端に寄せる */
  .work-card :global(.tags) {
    margin-top: auto;
    padding-top: 0.75rem;
  }
</style>
