---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags" role="list">
      {tags.map((tag) => (
        <li class="tag">{tag}</li>
      ))}
    </ul>
  )
}

<style>
  /* 余白（margin）はコンポーネント側で持たない。消費側が :global(.tags) で調整する */
  /* 中黒区切りの文字組み。塗りのあるピル型ではなく、Homeのスキル一覧（.skill-list）
     と同じ語彙で組み、サイト全体の文字組みを統一する。
     list-style: none は Safari でリストの読み上げが落ちるため role="list" を明示する */
  .tags {
    list-style: none;
    font-size: 0.85rem;
    color: var(--color-muted);
    letter-spacing: 0.06em;
  }
  .tag {
    display: inline;
  }
  .tag + .tag::before {
    content: "・";
    color: var(--accent);
    margin: 0 0.5em;
  }
</style>
